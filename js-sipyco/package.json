{
  "name": "js-sipyco",
  "private": true,
  "type": "module",
  "exports": {
    "./pyon": {
      "types": "./dist/pyon/pyon.d.ts",
      "default": "./dist/pyon/pyon.js"
    },
    "./pyonutils": {
      "types": "./dist/pyon/utils.d.ts",
      "default": "./dist/pyon/utils.js"
    },
    "./sync_struct": {
      "types": "./dist/sync_struct/sync_struct.d.ts",
      "default": "./dist/sync_struct/sync_struct.js"
    },
    "./pc_rpc": {
      "types": "./dist/pc_rpc/pc_rpc.d.ts",
      "default": "./dist/pc_rpc/pc_rpc.js"
    },
    "./broadcast": {
      "types": "./dist/broadcast/broadcast.d.ts",
      "default": "./dist/broadcast/broadcast.js"
    },
    "./net": {
      "types": "./dist/net.d.ts",
      "default": "./dist/net.js"
    }
  },
  "dependencies": {
    "fraction.js": "^5.3.4",
    "fast-deep-equal": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  },
  "scripts": {
    "build": "tsc && npm test -- --run",
    "watch": "tsc --watch",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src test \"*.{js,mjs,cjs}\" --max-warnings=0",
    "test": "vitest --dir test"
  }
}

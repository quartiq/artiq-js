{
  "name": "web-artiq",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tanstack/table-core": "^8.21.3",
    "gridstack": "^12.6.0",
    "minimist": "^1.2.8",
    "plotly.js-dist-min": "^3.5.1",
    "shell-quote": "^1.8.4",
    "sipyco": "file:../sipyco"
  },
  "scripts": {
    "build:sipyco": "npm --prefix ../sipyco install && npm --prefix ../sipyco run build",
    "build:web": "esbuild ./src/*.ts ./src/*.css --bundle --outdir=static --format=esm",
    "build": "npm run build:sipyco && npm run build:web",
    "watch:sipyco": "npm --prefix ../sipyco run watch",
    "watch:web": "esbuild ./src/*.ts ./src/*.css --bundle --outdir=static --format=esm --watch",
    "watch": "npm-run-all -p watch:sipyco watch:web"
  },
  "devDependencies": {
    "@types/minimist": "^1.2.5",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/shell-quote": "^1.7.5",
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}

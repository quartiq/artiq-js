{
  "name": "artiq-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "dependencies": {
    "@tanstack/table-core": "^8.21.3",
    "artiq-js": "file:../artiq-js",
    "gridstack": "^12.6.0",
    "minimist": "^1.2.8",
    "plotly.js-dist-min": "^3.5.1",
    "shell-quote": "^1.8.4",
    "sipyco-js": "file:../sipyco-js",
    "svelte": "^5.57.1"
  },
  "scripts": {
    "check-types": "svelte-check --tsconfig tsconfig.json",
    "build:artiq-web": "vite build",
    "build": "npm run check-types && npm run build:artiq-web",
    "watch": "npm-run-all -p watch:*",
    "watch:sipyco-js": "npm --prefix ../sipyco-js run watch",
    "watch:artiq-js": "npm --prefix ../artiq-js run watch",
    "watch:artiq-web": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint src \"*.{js,mjs,cjs}\" --max-warnings=0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/minimist": "^1.2.5",
    "@types/plotly.js-dist-min": "^2.3.4",
    "@types/shell-quote": "^1.7.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
